# ═══════════════════════════════════════════════════════════════════════════
#  Onay360 — ÜRETİM ortam değişkenleri örneği
#
#  Kullanım:
#     cp deploy/.env.prod.example deploy/.env
#     chmod 600 deploy/.env
#     # aşağıda "DOLDUR" yazan her satırı doldurun
#
#  🔴 BU DOSYADA GERÇEK SIR YOKTUR ve OLMAMALIDIR. Depoya giren dosya budur;
#     `deploy/.env` .gitignore'a EKLENMELİDİR (bkz. deploy/README.md).
#
#  🔴 SATIR SONUNA YORUM YAZMAYIN.
#     Docker Compose'un .env okuyucusu, DEĞERİ BOŞ olan bir satırdaki
#     `# ...` metnini YORUM DEĞİL DEĞER sayar. Yani
#         SESSION_SECRET=        # doldurulacak
#     satırı uygulamaya gerçekten "# doldurulacak" değerini verir ve hata
#     "SESSION_SECRET 32 bayt değil" olur — sebebi görünmez. (Ölçüldü.)
#     Bu dosyadaki açıklamalar bu yüzden hep satırın ÜSTÜNDEDİR.
#
#  🔴 SIRLAR TEK SEFERLİK ÜRETİLİR. SESSION_SECRET veya ENCRYPTION_KEY'i
#     ikinci kez üretmek: tüm oturumlar düşer ve veritabanındaki şifreli
#     sağlayıcı API anahtarları BİR DAHA ÇÖZÜLEMEZ. Rotasyon ayrı bir
#     prosedürdür (deploy/README.md "Sır rotasyonu").
#
#  Kaynak: api/internal/config/config.go Load() — burada listelenmeyen bir
#  değişkeni uygulama okumaz.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────── Dağıtım (compose ve Caddy okur, uygulama okumaz) ───────────────

# Caddy'nin sertifika alacağı alan adı. www YAZILMAZ; www.<DOMAIN> otomatik
# olarak buraya 301 ile yönlendirilir. DNS A/AAAA kaydı bu ada VPS IP'sini
# göstermeden Caddy TLS alamaz.
# DOLDUR
DOMAIN=onay360.com

# Let's Encrypt bildirimleri (yaklaşan son kullanma, sorunlar) buraya gider.
# DOLDUR
ACME_EMAIL=teknik@onay360.com

# İmaj etiketi. Üretimde `latest` KULLANMAYIN: geri alma "önceki etikete dön"
# demektir ve `latest` geri dönülecek bir nokta bırakmaz.
# Önerilen: git SHA'nın ilk 8 hanesi.
IMAGE_TAG=local
API_IMAGE=onay360-api
WEB_IMAGE=onay360-web


# ─────────────────────────── Çalışma ortamı ───────────────────────────

# 🔴 "production" değeri ek 7 zorunluluk getirir (config.go):
#      RECAPTCHA_SITE_KEY · RECAPTCHA_SECRET_KEY · WEBHOOK_HEROSMS_SECRET ·
#      SENTRY_DSN dolu olmalı; MAIL_PROVIDER "console" OLAMAZ;
#      PUBLIC_BASE_URL https:// ile başlamalı; WEBHOOK_HEROSMS_ALLOWED_IPS
#      boş olamaz. Herhangi biri eksikse süreç HİÇ BAŞLAMAZ — istenen budur.
APP_ENV=production

# ─── Arka plan işleri: hangi süreç koşturacak ───
#
# 🔴 ÇİFT KOŞMA KAPISI. Tek anahtar, iki süreç:
#      true  → işleri `api` konteyneri koşturur; `worker` konteyneri açılışta
#              "işler api sürecinde" deyip ÇIKAR (gürültülü, sessiz değil)
#      false → işleri `worker` konteyneri koşturur; `api` yalnız HTTP sunar
#    İkisinin birden koşturduğu bir kombinasyon yoktur.
#
# Üretimde önerilen: false. Kazancı, api'yi dağıtım için yeniden başlatmanın
# devam eden bir sipariş yoklama turunu KESMEMESİ.
# (Sözleşme: api/cmd/worker/main.go paket yorumu.)
WORKERS_IN_PROCESS=false

# Konteyner içi dinleme adresi. compose bunu zaten :8080 olarak geçiyor;
# değiştirmek Caddy'nin `api:8080` yukarı akışını kırar.
#
# Not: kökteki .env.example (geliştirme) :8090 diyor; README, CI ve
# web/.env.local ise 8091 kullanıyor. O tutarsızlık geliştirme dosyasındadır
# ve ayrıca düzeltilmelidir. Üretimde tek doğru değer :8080'dir.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# Kullanıcıya gönderilen bağlantılar (e-posta doğrulama, şifre sıfırlama)
# bu adresle kurulur. Üretimde https:// ZORUNLU.
# DOLDUR
PUBLIC_BASE_URL=https://onay360.com


# ─────────────────────────── PostgreSQL ───────────────────────────
#
# 🔴 DATABASE_URL BURADA TANIMLANMAZ. Compose onu aşağıdaki üç değerden
#    kurar (docker-compose.prod.yml → api.environment). Aynı bağlantı
#    dizesini iki yerde tutmak, birini değiştirip diğerini unutmaktır.
#
# 🔴 PAROLA YALNIZ HARF VE RAKAM OLSUN:
#       openssl rand -hex 24
#    Parola bir URL'in içine gömülüyor; @ : / ? # % karakterleri URL'yi
#    sessizce bozar ve hata "bağlanılamadı" olur — sebebi saatler alır.
POSTGRES_USER=smsplatform

# DOLDUR:  openssl rand -hex 24
POSTGRES_PASSWORD=

POSTGRES_DB=smsplatform


# ─────────────────────────── Redis ───────────────────────────
#
# REDIS_URL de compose tarafından kurulur; burada tanımlamayın.
#
# DOLDUR:  openssl rand -hex 24   (yalnız harf/rakam — URL'e gömülüyor)
REDIS_PASSWORD=

# Redis'in kullanabileceği azami bellek. Politika `noeviction` olduğu için
# bu sınıra ulaşıldığında yazmalar HATA verir (anahtarlar sessizce silinmez).
# VPS belleğinin ~%10'u iyi bir başlangıçtır.
REDIS_MAXMEMORY=256mb


# ─────────────────────── Oturum ve şifreleme ───────────────────────
#
# İkisi de TAM 32 BAYT çözülmelidir (api/internal/config/key.go).
# Üretme komutu:
#     openssl rand -base64 32
# 🔴 `openssl rand -hex 16` KULLANMAYIN — 16 bayt verir, süreç başlamaz.
#    (`openssl rand -hex 32` 32 bayt verir ve geçerlidir.)
#
# DOLDUR:  openssl rand -base64 32
SESSION_SECRET=

# 🔴 Sağlayıcı API anahtarları BU anahtarla AES-GCM ile şifrelenip
#    veritabanında durur (providers.api_key_enc). Değeri kaybetmek ya da
#    değiştirmek, kayıtlı tüm sağlayıcı anahtarlarının çözülemez olması
#    demektir. Çevrimdışı, iki kopya hâlinde saklayın.
#
# DOLDUR:  openssl rand -base64 32
ENCRYPTION_KEY=

# Oturum ömrü (pozitif bir süre).
SESSION_TTL=720h


# ─────────────────────────── Döviz kuru (FX) ───────────────────────────
#
# Not: FX_PROVIDER bugün OKUNUYOR ama kablolamada kullanılmıyor; tek kaynak
# TCMB'dir (api/cmd/server/main.go). "manual" yazmak bir şeyi değiştirmez.
FX_PROVIDER=tcmb

# Kur dalgalanmasına karşı güvenlik payı (yüzde).
FX_SAFETY_MARGIN_PCT=2.0

# Kur bu yaştan eskiyse bayat sayılır (runbook: "Kur bayat" senaryosu).
FX_MAX_AGE=30m


# ─────────────────────────── reCAPTCHA ───────────────────────────
#
# Üretimde İKİSİ DE ZORUNLU. Anahtarlar:
#   https://www.google.com/recaptcha/admin  → reCAPTCHA v2 "onay kutusu"
#
# DOLDUR (herkese açık değer, sır değil)
RECAPTCHA_SITE_KEY=

# DOLDUR — 🔴 GERÇEK SIR
RECAPTCHA_SECRET_KEY=

# 🔴 Aynı SİTE anahtarının ön yüz kopyası — ve o taraf DERLEME ANINDA
#    gömülür (deploy/Dockerfile.web). Bu değeri değiştirdiğinizde web imajını
#    YENİDEN DERLEMENİZ gerekir; konteyneri yeniden başlatmak hiçbir şey
#    yapmaz ve kayıt formu sessizce çalışmaz hâle gelir.
#
# DOLDUR — RECAPTCHA_SITE_KEY ile AYNI değer
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=


# ─────────────────────────── E-posta ───────────────────────────
#
# Üretimde "console" YASAKTIR (config.go) — e-postasız çalışmak sessiz
# arızadır: doğrulama ve şifre sıfırlama kullanıcıya hiç ulaşmaz.
#
# console | resend | smtp
MAIL_PROVIDER=resend

# DOLDUR
MAIL_FROM=noreply@onay360.com

# MAIL_PROVIDER=resend ise DOLDUR — 🔴 GERÇEK SIR
RESEND_API_KEY=

# MAIL_PROVIDER=smtp ise dört alan da zorunludur (config.go, ortamdan
# bağımsız): eksik bir alanla açılan bir SMTP istemcisi, e-postaları
# gönderiyormuş gibi yapar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# 🔴 GERÇEK SIR
SMTP_PASSWORD=


# ─────────────────────── Webhook (HeroSMS) ───────────────────────
#
# Tahmin edilemez yol segmenti — anahtar değil, 16 bayt yeterli:
#     openssl rand -hex 16
# Tam URL:
#     https://<DOMAIN>/api/v1/webhooks/herosms/<WEBHOOK_HEROSMS_SECRET>
# Bu URL HeroSMS panelinden ELLE girilir (API ucu yok, en fazla 3 slot var ve
# slotlar hesap genelindedir — staging ile üretim aynı hesabı paylaşamaz).
# Boş bırakılırsa webhook rotası HİÇ KAYDEDİLMEZ (üretimde zaten zorunlu).
#
# DOLDUR:  openssl rand -hex 16
WEBHOOK_HEROSMS_SECRET=

# Sağlayıcının kaynak IP'leri. HeroSMS webhook'unda İMZA YOKTUR; bu liste
# tek savunma katmanıdır, bu yüzden üretimde boş olamaz.
#
# Bu filtre ters vekil arkasında doğru çalışır: aşağıdaki TRUSTED_PROXIES
# ayarlandığında webhook, Caddy'nin ilettiği GERÇEK kaynak IP'sini görür.
WEBHOOK_HEROSMS_ALLOWED_IPS=84.32.223.53,185.138.88.87

# Ters vekilin ağ aralığı (CIDR, virgülle ayrılmış).
#
# 🔴 ÜRETİMDE ZORUNLU — boş bırakılırsa süreç BAŞLAMAZ.
# Vekil başlıklarına (X-Forwarded-For / X-Real-IP) yalnız bu aralıklardan
# gelen bağlantılarda bakılır. Docker'da Caddy ayrı bir konteynerdir; varsayılan
# compose ağı 172.16.0.0/12 içindedir. Kendi ağınızı görmek için:
#   docker network inspect <ag_adi> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#
# "0.0.0.0/0" REDDEDİLİR: o değer "vekil başlığı uyduran herkese güven" demektir
# ve izin listesini de IP hız limitini de tümüyle atlatılabilir kılar.
TRUSTED_PROXIES=172.16.0.0/12


# ─────────────────────────── Dekont yükleme (FR-500) ───────────────────────────

# Yüklenen dekontların (JPEG/PNG/PDF, ≤ 5 MB) saklandığı KALICI dizin.
#
# 🔴 ÜRETİMDE ZORUNLU ve MUTLAK yol olmalı — boş ya da göreli bırakılırsa
# süreç BAŞLAMAZ. Göreli bir yol, sürecin çalışma dizinine göre değişir ve
# yeniden başlatmada başka bir dizine düşer.
#
# 🔴 WEB KÖKÜNÜN DIŞINDA olmalı ve Caddy'den servis EDİLMEZ: dekont doğrudan
# bir URL ile açılamaz, yalnız yetkili API uçlarından okunur (KK-500).
#
# 🔴 KONTEYNER İÇİ YOLDUR. Bu dizin bir docker volume ile kalıcı hâle
# getirilmelidir; aksi hâlde her dağıtımda tüm dekontlar silinir:
#     services.api.volumes:  - onay360-uploads:/var/lib/onay360/uploads
# Yazılabilirliği açılışta doğrulanır (api kullanıcısının yazma izni olmalı).
UPLOAD_DIR=/var/lib/onay360/uploads


# ─────────── Sağlayıcı ilk kurulumu (BOOTSTRAP — kalıcı değil) ───────────
#
# Bu değer YALNIZCA `cli provider:add --env-key=HEROSMS_API_KEY` komutunun
# ilk kaydı oluşturmasında okunur; komut anahtarı AES-GCM ile şifreleyip
# veritabanına yazar. Kayıt oluştuktan sonra BU SATIRI BOŞALTIN.
# Anahtar komut satırına yazılmaz (ps çıktısına ve kabuk geçmişine düşer).
#
# DOLDUR — 🔴 GERÇEK SIR (kayıttan sonra sil)
HEROSMS_API_KEY=

HEROSMS_BASE_URL=https://hero-sms.com


# ─────────────────────── Gözlemlenebilirlik ───────────────────────
#
# Üretimde zorunlu. Panelden alınan DSN
# (api/internal/adapter/obs/sentry.go kablolaması).
#
# DOLDUR — 🔴 GERÇEK SIR sayılmalı (yazma yetkisi verir)
SENTRY_DSN=

# Prometheus /metrics ucu. Uç, uygulamanın ÖNÜNDE ayrı bir mux'ta duruyor
# (api/cmd/server/main.go withMetricsEndpoint) ve api:8080 üzerinden servis
# ediliyor.
# 🔴 DIŞARIYA AÇILMAZ: Caddy /metrics* yolunu 404'lüyor. Prometheus'a
#    konteyner ağı içinden (api:8080/metrics) erişilir.
METRICS_ENABLED=true


# ─────────────────────────── Ön yüz ───────────────────────────
#
# 🔴 DERLEME ANINDA gömülür. robots.txt, sitemap.xml ve canonical etiketleri
#    bunu kullanır; boş kalırsa arama motorlarına localhost adresi verilir.
#    Alan adı değişirse web imajı YENİDEN DERLENİR.
#
# DOLDUR
NEXT_PUBLIC_SITE_URL=https://onay360.com

# API_ORIGIN compose tarafından http://api:8080 olarak veriliyor; burada
# tanımlamayın.


# ────────── Yedekleme (deploy/scripts/yedekle.sh · geri-yukle.sh) ──────────

# Yedeklerin yazılacağı dizin (VPS üzerinde).
BACKUP_DIR=/var/backups/onay360

# 🔴 Yedek ŞİFRELENİR — içinde parola özetleri, oturum verisi ve AES-GCM
#    şifreli sağlayıcı API anahtarları var.
#    Aşağıdaki İKİSİNDEN BİRİNİ doldurun (ikisi de boşsa betik çalışmaz).
#
#  (a) age — önerilen, tek küçük ikili:
#        age-keygen -o /root/.onay360-backup.key      # ÖZEL anahtar
#        grep 'public key' /root/.onay360-backup.key  # buraya yazılacak değer
#      Örnek biçim: age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9a...
BACKUP_AGE_RECIPIENT=

#  (b) gpg — kurumda zaten GPG kullanılıyorsa:
#        gpg --list-keys   → alıcı e-postası veya parmak izi
BACKUP_GPG_RECIPIENT=

# 🔴 ÖZEL ANAHTAR KAYBOLURSA TÜM YEDEKLER GERİ GETİRİLEMEZ.
#    Çevrimdışı, iki ayrı fiziksel kopya. Sunucuda TUTULMAZ.

# Kaç gün saklanacak (NFR-808: 30).
BACKUP_RETENTION_DAYS=30

# 🔴 AYRI KONUM ZORUNLU (NFR-808). Aynı diskteki yedek, disk arızasında
#    yedek değildir. `rclone` hedefi (önerilen, örn. b2:onay360-yedek/db)
#    veya `kullanici@host:/yol` biçiminde bir scp hedefi.
#    APP_ENV=production iken boşsa yedekleme BAŞARISIZ sayılır.
#
# DOLDUR
BACKUP_REMOTE=

# Bundan küçük bir dump kabul edilmez (bozuk/boş yedeği "yedek" saymamak
# için). Bayt.
BACKUP_MIN_BYTES=65536
