9:T822,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Sanal numara nedir?","acceptedAnswer":{"@type":"Answer","text":"Yalnız SMS almak için kullanılan geçici bir telefon numarasıdır. Bir servise kayıt olurken doğrulama kodu bu numaraya gelir ve kod ekranınızda görünür."}},{"@type":"Question","name":"Kod ne kadar sürede geliyor?","acceptedAnswer":{"@type":"Answer","text":"Çoğu serviste 10–30 saniye içinde gelir. Numara alındıktan sonra bekleme ekranı açık kalır ve kod düştüğü anda ekrana yansır."}},{"@type":"Question","name":"Aynı numarayı tekrar kullanabilir miyim?","acceptedAnswer":{"@type":"Answer","text":"Hayır. Her numara tek bir doğrulama için verilir. Aynı servise tekrar kayıt olmak için yeni bir numara almanız gerekir."}},{"@type":"Question","name":"Kod gelmezse ne oluyor?","acceptedAnswer":{"@type":"Answer","text":"Numaranın süresi kod gelmeden dolarsa ücret otomatik olarak bakiyenize iade edilir. İade için talep açmanıza gerek yoktur; sistem bunu kendisi yapar."}},{"@type":"Question","name":"Numarayı iptal edebilir miyim?","acceptedAnswer":{"@type":"Answer","text":"Evet. Numara alındıktan kısa bir süre sonra iptal düğmesi aktifleşir. Kod gelmemişse iptal ettiğinizde ücret bakiyenize döner."}},{"@type":"Question","name":"Bakiyemi nasıl yüklerim?","acceptedAnswer":{"@type":"Answer","text":"Banka havalesi/EFT veya USDT ile yükleme yapabilirsiniz. Ödemeniz onaylandıktan sonra bakiyeniz hesabınıza tanımlanır."}},{"@type":"Question","name":"Numara kiralama nedir?","acceptedAnswer":{"@type":"Answer","text":"Tek kullanımlık numara yalnız bir doğrulama kodu için verilir. Kiralamada ise numara seçtiğiniz süre boyunca (1 gün ile 6 ay arası) size aittir ve o süre içinde gelen tüm SMS mesajlarını görürsünüz."}},{"@type":"Question","name":"Aylık numara kiralayabilir miyim?","acceptedAnswer":{"@type":"Answer","text":"Evet. 30 günlük kiralama en çok tercih edilen modeldir; 60, 90 ve 180 günlük seçenekler de mevcuttur."}}]}0:{"P