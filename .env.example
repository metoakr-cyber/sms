# ─── Çalışma ortamı ───
APP_ENV=development            # development | staging | production
HTTP_ADDR=:8090
LOG_LEVEL=debug                # debug | info | warn | error

# ─── Veritabanı ───
DATABASE_URL=postgres://smsplatform:devpassword@localhost:55432/smsplatform?sslmode=disable

# ─── Redis ───
REDIS_URL=redis://localhost:56379/0

# ─── Oturum ───
# 32 baytlık rastgele: openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL=720h

# ─── Şifreleme (sağlayıcı API anahtarları için, AES-GCM) ───
# 32 baytlık rastgele: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Kur (FX) ───
FX_PROVIDER=tcmb               # tcmb | manual
FX_SAFETY_MARGIN_PCT=2.0
FX_MAX_AGE=30m

# ─── reCAPTCHA ───
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── E-posta ───
MAIL_PROVIDER=console          # console | resend | smtp
MAIL_FROM=noreply@example.com
RESEND_API_KEY=

# ─── Sağlayıcı ilk kurulumu (BOOTSTRAP) ───
# DİKKAT: Sağlayıcı API anahtarları kalıcı olarak BURADA DURMAZ.
# Çalışma zamanında veritabanından okunur (providers.api_key_enc, AES-GCM şifreli)
# ve admin panelinden yönetilir.
# Buradaki değer YALNIZCA `make seed-provider` komutunun ilk kaydı oluşturmasında kullanılır.
# Kayıt oluştuktan sonra bu satır silinebilir.
HEROSMS_API_KEY=
HEROSMS_BASE_URL=https://hero-sms.com

# ─── Webhook ───
# tahmin edilemez yol segmenti: openssl rand -hex 16
WEBHOOK_HEROSMS_SECRET=
# HeroSMS kaynak IP'leri (spec'te yazılı) — virgülle ayrılmış
WEBHOOK_HEROSMS_ALLOWED_IPS=84.32.223.53,185.138.88.87

# ─── Gözlemlenebilirlik ───
SENTRY_DSN=
METRICS_ENABLED=true

# ─── Genel ───
PUBLIC_BASE_URL=http://localhost:3000
